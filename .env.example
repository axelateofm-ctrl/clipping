# --- AXIE Video Splitter — variables d'environnement ---
# Toutes sont facultatives : des valeurs par défaut raisonnables existent.

# Réseau (Railway fournit PORT automatiquement)
# PORT=8000
# HOST=0.0.0.0

# Répertoire de travail (monter un volume Railway ici pour la persistance)
DATA_DIR=/data

# Limites
MAX_UPLOAD_MB=4096          # taille max d'un fichier importé
MAX_CONCURRENCY=1           # nombre de traitements FFmpeg simultanés
MIN_FREE_DISK_MB=1024       # marge disque minimale à préserver
EXPORT_SPACE_FACTOR=1.6     # espace estimé nécessaire = taille source x facteur

# Conservation / nettoyage
RETENTION_MINUTES=120       # durée de vie des fichiers avant suppression
CLEANUP_INTERVAL_MINUTES=15 # fréquence du nettoyage automatique

# Découpage par défaut
DEFAULT_TARGET=70
DEFAULT_WINDOW=10
DEFAULT_SILENCE_DB=-35
DEFAULT_SILENCE_MIN=0.25

# Ré-encodage (qualité)
X264_CRF=18
X264_PRESET=medium
AUDIO_BITRATE=192k

# Protection d'accès (laisser vide = accès libre, usage perso local)
APP_PASSWORD=

# CORS en développement (ex: http://localhost:5173). Vide en production.
CORS_ORIGINS=
